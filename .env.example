# Copy this file to .env for local development. Do not commit .env.
# Shopify CLI can add SHOPIFY_* variables when you run `npm run dev`.

DATABASE_URL="postgresql://upsell:upsell@localhost:5434/checkout_upsell?schema=public"
SHOPIFY_API_KEY="replace-with-your-app-client-id"
SHOPIFY_API_SECRET="replace-with-your-app-client-secret"
SHOPIFY_APP_URL="https://replace-with-your-development-tunnel"

# Optional. Shopify CLI/app configuration normally provides requested scopes.
# SCOPES="read_products,read_orders"

# Optional. Required only when your app uses a custom shop domain.
# SHOP_CUSTOM_DOMAIN="shop.example.com"
