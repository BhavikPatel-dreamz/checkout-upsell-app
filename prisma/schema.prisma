// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// OAuth / session storage — required by @shopify/shopify-app-react-router
// (PrismaSessionStorage). Do not rename or remove; the adapter fixes this shape.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// App-level record for an installed shop. OAuth data lives in `Session`;
// this is the home for per-shop app settings and config going forward.
model Shop {
  id        String   @id @default(cuid())
  shop      String   @unique // myshopify.com domain
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OfferType {
  cross_sell
  bundle
  volume
  free_gift
  subscription
}

enum OfferPlacement {
  product_page
  cart_drawer
  checkout
  post_purchase
  order_status
}

enum OfferEventType {
  viewed
  accepted
  declined
}

model Offer {
  id               String         @id @default(cuid())
  shop             String // myshopify.com domain — every query is scoped by this
  name             String
  type             OfferType
  placement        OfferPlacement
  targetProductIds String[] // Shopify product GIDs, e.g. gid://shopify/Product/123
  triggerRules     Json? // e.g. { "cartValueMin": 50, "collectionIds": [...], "customerTags": [...] }
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  events OfferEvent[]

  @@index([shop])
  @@index([shop, placement, isActive])
}

model OfferEvent {
  id        String         @id @default(cuid())
  offerId   String
  offer     Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  shop      String // denormalized for fast shop-scoped analytics
  eventType OfferEventType
  orderId   String? // Shopify order GID when the event ties to an order
  revenue   Decimal?       @db.Decimal(12, 2)
  createdAt DateTime       @default(now())

  @@index([offerId, eventType])
  @@index([shop])
  @@index([offerId, createdAt])
}

// Synced Shopify catalog — ONE ROW PER VARIANT (the unit we upsell/suggest).
// Populated by the dashboard "Sync products" action, upserted by [shop, variantId].
// Parent-product fields are denormalized onto each variant row. Standard core.
model ProductVariant {
  id   String @id @default(cuid())
  shop String // myshopify.com domain — every query is scoped by this

  // Variant — this row's identity
  variantId         String // gid://shopify/ProductVariant/123
  variantTitle      String? // e.g. "Small / Blue"
  sku               String?
  price             Decimal? @db.Decimal(12, 2)
  compareAtPrice    Decimal? @db.Decimal(12, 2)
  inventoryQuantity Int?
  availableForSale  Boolean  @default(true)
  selectedOptions   Json? // [{ "name": "Size", "value": "Small" }, ...]
  imageUrl          String? // variant image, falling back to product image at sync time

  // Parent product — denormalized onto every variant row
  productId     String // gid://shopify/Product/123
  productTitle  String
  productHandle String?
  productStatus String? // ACTIVE | ARCHIVED | DRAFT

  syncedAt  DateTime @default(now()) // stamp of the run that last touched this row
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, variantId])
  @@index([shop])
  @@index([shop, productId])
}

// One row per product-sync run, shop-scoped. Powers the dashboard progress bar
// (via `estimated`, the prior successful run's variant count) and the sync-log
// history table. Written by app/models/syncLog.server.ts. Standard core.
model SyncLog {
  id         String    @id @default(cuid())
  shop       String // myshopify.com domain — every query is scoped by this
  status     String    @default("running") // running | success | error
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  pages      Int       @default(0)
  upserted   Int       @default(0) // variant rows created or updated this run
  removed    Int       @default(0) // stale rows deleted on the final chunk
  estimated  Int? // progress denominator = prior successful run's upserted
  cursor     String? // resume from the last processed Shopify page after refresh/close
  error      String?
  createdAt  DateTime  @default(now())

  @@index([shop, startedAt])
}

// ===========================================================================
// Legacy (v1) upsell app — ported from upSell_live.sql (MySQL 8.0 / Laravel).
//
// Faithful structural port of the previous production schema so its data can
// be migrated into / read from this app. Original table + column names are
// preserved via @@map / @map, integer auto-increment PKs are kept, and MySQL
// types are translated to Postgres/Prisma equivalents:
//   tinyint(1) -> Boolean · text/longtext -> String @db.Text
//   enum('0','1') -> String (codes documented inline) · bigint unsigned -> BigInt
//
// These models are intentionally kept SEPARATE from the new Offer/OfferEvent
// core (the Standard product) and carry no relations to it — the legacy DB had
// no FK constraints, and upsell_id/client_id links mix int/bigint types.
// Excluded from the dump: Laravel framework tables (migrations, jobs,
// failed_jobs) and admin-auth tables (admins, upsell_admin).
// ===========================================================================

// Per-product upsell configuration (NOT the Shopify product catalog).
model Product {
  id              BigInt    @id @default(autoincrement())
  title           String?   @db.Text
  showUpsell      Boolean   @default(true) @map("show_upsell") // 1=Always, 0=Based on Condition
  isCondition     Boolean?  @map("is_condition") // 1=is_order, 0=is_customer_tag
  upsellOn        String?   @map("upsell_on") @db.VarChar(255)
  upsellDaterange String?   @map("upsell_daterange") @db.VarChar(100)
  product         String?   @db.VarChar(255) // 0=manual, 1=related, 2=random
  shopDomain      String?   @map("shop_domain") @db.VarChar(255)
  productId       String?   @map("product_id") @db.Text
  variantId       String?   @map("variant_id") @db.Text
  offer           Int? // 1=Free, 2=Discount, 0=As it is
  isDiscount      Int?      @map("is_discount")
  promotionTitle  String?   @map("promotion_title") @db.VarChar(255)
  action          Boolean   @default(true) // 0=off, 1=on
  attribute       String?   @db.VarChar(100)
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  @@map("products")
}

model UpsellCriteria {
  id                Int      @id @default(autoincrement())
  upsellId          Int?     @map("upsell_id")
  conditionType     String?  @map("condition_type") @db.VarChar(255)
  conditionCriteria String?  @map("condition_criteria") @db.VarChar(255)
  conditionValue    String?  @map("condition_value") @db.VarChar(255)
  andOr             String?  @map("and_or") @db.VarChar(255)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("upsell_criteria")
}

model UpsellHistory {
  id         Int      @id @default(autoincrement())
  upsellId   BigInt?  @map("upsell_id")
  customerId String?  @map("customer_id") @db.VarChar(255)
  productId  String?  @map("product_id") @db.VarChar(255)
  variantId  String?  @map("variant_id") @db.VarChar(255)
  shopdomain String?  @db.VarChar(255)
  action     String   @default("1") // 1=display, 2=Added
  attribute  String?  @db.VarChar(255)
  type       String?  @db.VarChar(20)
  dateTime   DateTime @default(now()) @map("date_time")

  @@map("upsell_history")
}

model Condition {
  id              Int      @id @default(autoincrement())
  conditionTypeId Int      @map("condition_type_id")
  conditionName   String   @map("condition_name") @db.VarChar(255)
  isActive        Boolean  @default(true) @map("is_active") // 1=Active, 0=Inactive
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("conditions")
}

model ConditionType {
  id        Int       @id @default(autoincrement())
  type      String    @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("condition_type")
}

model Discount {
  id         Int      @id @default(autoincrement())
  variantId  String   @map("variant_id") @db.VarChar(255)
  shop       String   @db.VarChar(255)
  discountId String   @map("discount_id") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("discounts")
}

model Setting {
  id              BigInt    @id @default(autoincrement())
  shopDomain      String?   @map("shop_domain") @db.VarChar(255)
  backgroundColor String?   @map("background_color") @db.VarChar(255)
  buttonTitle     String?   @map("button_title") @db.VarChar(255)
  textColor       String?   @map("text_color") @db.VarChar(255)
  borderColor     String?   @map("border_color") @db.VarChar(20)
  titleSize       String?   @map("title_size") @db.VarChar(20)
  buttonBorder    String?   @map("button_border") @db.VarChar(20)
  buttonRadious   String?   @map("button_radious") @db.VarChar(20) // legacy spelling preserved
  createdAt       DateTime? @map("created_at")
  updatedAt       DateTime? @default(now()) @map("updated_at")

  @@map("setting")
}

model StoreDetail {
  id              Int       @id @default(autoincrement())
  url             String    @db.VarChar(255)
  accesstoken     String?   @db.VarChar(255)
  storefrontToken String?   @map("storefront_token") @db.VarChar(255)
  isPlus          Boolean?  @map("is_plus")
  name            String?   @db.VarChar(150)
  email           String?   @db.VarChar(150)
  timeZone        String?   @map("time_zone") @db.VarChar(150)
  moneyFormat     String?   @map("money_format") @db.VarChar(150)
  planDisplayName String?   @map("plan_display_name") @db.VarChar(50)
  planName        String?   @map("plan_name") @db.VarChar(50)
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @default(now()) @map("updated_at")
  isActive        Boolean   @default(true) @map("is_active") // 0=inactive, 1=active

  @@map("storedetails")
}

model StoreHistory {
  id          Int      @id @default(autoincrement())
  shop        String?  @db.VarChar(255)
  email       String?  @db.VarChar(255)
  isInstalled Boolean? @map("is_installed")
  dateTime    DateTime @default(now()) @map("date_time")

  @@map("store_history")
}

model RecurringApplicationCharge {
  id        BigInt   @id @default(autoincrement())
  clientId  Int      @map("client_id")
  chargeId  String?  @map("charge_id") @db.VarChar(255)
  name      String?  @db.VarChar(255)
  price     String?  @db.VarChar(10)
  response  String?  @db.Text
  isApprove Boolean  @default(false) @map("is_approve") // 0=unapproved, 1=approved
  isActive  Boolean  @default(true) @map("is_active") // 0=inactive, 1=active
  created   DateTime @default(now())
  modified  DateTime @default(now())

  @@map("recurring_application_charge")
}

model Webhook {
  id        Int       @id @default(autoincrement())
  clientId  Int?      @map("client_id")
  webhookId String?   @map("webhook_id") @db.VarChar(255)
  topic     String?   @db.VarChar(255)
  address   String?   @db.VarChar(255)
  response  String?   @db.Text
  created   DateTime? @default(now())
  modified  DateTime? @default(now())

  @@map("webhooks")
}

model Gdpr {
  id        Int      @id @default(autoincrement())
  topic     String   @db.VarChar(25)
  response  String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("GDPR")
}

model JobsHistory {
  id        BigInt   @id @default(autoincrement())
  store     String?  @db.VarChar(200)
  job       String?  @db.VarChar(100)
  status    String   @default("0") // enum('0','1')
  createdAt DateTime @default(now()) @map("created_at")

  @@map("jobs_history")
}

model Currency {
  id             Int    @id @default(autoincrement())
  currencyCode   String @map("currency_code") @db.VarChar(3)
  currencyName   String @map("currency_name") @db.VarChar(50)
  currencySymbol String @map("currency_symbol") @db.VarChar(50)

  @@map("currency")
}
