<script>
  window.CHECKOUT_UPSELL_ACTIVITY = {
    shop: {{ shop.permanent_domain | json }},
    customerId: {% if customer %}"gid://shopify/Customer/{{ customer.id }}"{% else %}null{% endif %},
    template: {% if template.name %}{{ template.name | json }}{% else %}{{ template | json }}{% endif %},
    productId: {% if product %}"gid://shopify/Product/{{ product.id }}"{% else %}null{% endif %},
    variantId: {% if product.selected_or_first_available_variant %}"gid://shopify/ProductVariant/{{ product.selected_or_first_available_variant.id }}"{% else %}null{% endif %},
    collectionId: {% if collection %}"gid://shopify/Collection/{{ collection.id }}"{% else %}null{% endif %},
    query: {% if search.terms %}{{ search.terms | json }}{% else %}null{% endif %},
    activityUrl: "/apps/checkout-upsell/api/activity"
  };
</script>
{% comment %}
  Optional theme markup (after this embed is enabled):
  <a class="cu-track" data-cu-event="product_click" data-cu-product-id="{{ product.id }}">…</a>
  <button class="cu-track cu-track--size_guide_open">Size guide</button>
  CheckoutUpsellActivity.track("wishlist_add", { productId: product.id })
{% endcomment %}

{% schema %}
{
  "name": "Upsell activity",
  "target": "head",
  "javascript": "activity-beacon.js"
}
{% endschema %}
