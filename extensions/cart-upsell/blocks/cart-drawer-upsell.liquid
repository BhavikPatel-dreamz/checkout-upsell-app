<div id="cart-drawer-upsell-root" class="cart-drawer-upsell-block" style="display: none; border-top: 1px solid #e5e5e5; padding: 16px 0; margin-top: 12px;">
  <h3 style="margin: 0 0 12px; font-size: 16px; font-weight: 600;">{{ "cart_upsell.title" | t }}</h3>
  <div id="cart-drawer-upsell-items" style="display: flex; flex-direction: row; gap: 12px; overflow-x: auto; overflow-y: hidden; padding-bottom: 8px; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch;"></div>
  <div id="cart-drawer-upsell-error" style="display: none; color: #d32f2f; font-size: 12px; margin-top: 8px;"></div>
</div>

<script>
  window.CART_DRAWER_UPSELL_CONFIG = {
    eligibilityUrl: "/apps/checkout-upsell/api/offers/eligible",
    viewedUrl: "/apps/checkout-upsell/api/offers/viewed",
    clickedUrl: "/apps/checkout-upsell/api/offers/clicked",
    addedToCartUrl: "/apps/checkout-upsell/api/offers/added-to-cart",
    customerId: {% if customer %}"gid://shopify/Customer/{{ customer.id }}"{% else %}null{% endif %},
    shop: {{ shop.permanent_domain | json }},
    addToCartLabel: {{ "cart_upsell.add_to_cart" | t | json }},
    viewLabel: {{ "product_upsell.view" | t | json }}
  };
</script>

{% schema %}
{
  "name": "Cart Drawer Upsell",
  "target": "body",
  "javascript": "cart-drawer-upsell.js"
}
{% endschema %}
