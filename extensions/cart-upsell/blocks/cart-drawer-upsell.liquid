<div
  id="cart-drawer-upsell-root"
  class="cart-drawer-upsell-block"
  style="
    display: none;
    --upsell-border-top: {% if block.settings.show_top_border %}1px solid {{ block.settings.border_color }}{% else %}none{% endif %};
    --upsell-heading-color: {{ block.settings.heading_color }};
    --upsell-heading-size: {{ block.settings.heading_font_size }}px;
    --upsell-card-bg: {{ block.settings.card_bg_color }};
    --upsell-card-border: 1px solid {{ block.settings.border_color }};
    --upsell-card-radius: {{ block.settings.card_corner_radius }}px;
    --upsell-title-color: {{ block.settings.title_color }};
    --upsell-subtext-color: {{ block.settings.subtext_color }};
    --upsell-price-color: {{ block.settings.price_color }};
    --upsell-btn-bg: {{ block.settings.button_bg_color }};
    --upsell-btn-text: {{ block.settings.button_text_color }};
    --upsell-btn-radius: {{ block.settings.button_corner_radius }}px;
    --upsell-error-color: {{ block.settings.error_color }};
    padding: 16px 0;
    margin-top: 12px;
    border-top: var(--upsell-border-top);
  "
>
  <h3 class="cart-drawer-upsell-heading">
    {% if block.settings.heading_text != blank %}{{ block.settings.heading_text }}{% else %}{{ "cart_upsell.title" | t }}{% endif %}
  </h3>
  <div id="cart-drawer-upsell-editor-notice" class="cart-drawer-upsell-editor-notice" style="display: none;"></div>
  <div id="cart-drawer-upsell-items" class="cart-drawer-upsell-items"></div>
  <div id="cart-drawer-upsell-error" class="cart-drawer-upsell-error"></div>
</div>

<style>
  .cart-drawer-upsell-heading {
    margin: 0 0 12px;
    font-size: var(--upsell-heading-size);
    font-weight: 600;
    color: var(--upsell-heading-color);
  }

  .cart-drawer-upsell-items {
    display: flex;
    flex-direction: row;
    gap: 12px;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 8px;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }

  .cart-drawer-upsell-editor-notice {
    display: none;
    margin: 0 0 12px 0;
    padding: 10px 12px;
    border-radius: 6px;
    background: #f4f6f8;
    border: 1px dashed #8c9196;
    color: #42474c;
    font-size: 13px;
    line-height: 1.45;
  }

  .cart-drawer-upsell-error {
    display: none;
    color: var(--upsell-error-color);
    font-size: 12px;
    margin-top: 8px;
  }

  .cart-drawer-upsell-placeholder-img {
    width: 64px;
    height: 64px;
    border-radius: 4px;
    flex: none;
    background: linear-gradient(135deg, #ececec 0%, #f8f8f8 100%);
  }

  .cart-drawer-upsell-card--preview {
    opacity: 0.92;
  }

  .cart-drawer-upsell-preview-badge {
    margin-top: 8px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--upsell-subtext-color);
  }

  .cart-drawer-upsell-card {
    flex: 0 0 300px;
    box-sizing: border-box;
    scroll-snap-align: start;
    display: flex;
    gap: 10px;
    align-items: flex-start;
    background: var(--upsell-card-bg);
    border: var(--upsell-card-border);
    border-radius: var(--upsell-card-radius);
    padding: 10px;
    min-height: 150px;
  }

  .cart-drawer-upsell-card img {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: 4px;
    flex: none;
  }

  .cart-drawer-upsell-card .cart-drawer-upsell-promo {
    font-size: 12px;
    color: var(--upsell-subtext-color);
  }

  .cart-drawer-upsell-card .cart-drawer-upsell-product-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--upsell-title-color);
  }

  .cart-drawer-upsell-card .cart-drawer-upsell-variant {
    font-size: 12px;
    color: var(--upsell-subtext-color);
  }

  .cart-drawer-upsell-card .cart-drawer-upsell-price {
    color: var(--upsell-price-color);
  }

  .cart-drawer-upsell-card a.cart-drawer-upsell-view {
    font-size: 12px;
    display: block;
    margin-top: 4px;
    color: var(--upsell-title-color);
  }

  .cart-drawer-upsell-btn {
    display: block;
    margin-top: 8px;
    padding: 8px 10px;
    border: 0;
    border-radius: var(--upsell-btn-radius);
    background: var(--upsell-btn-bg);
    color: var(--upsell-btn-text);
    cursor: pointer;
    font-size: 12px;
  }
</style>

<script>
  window.CART_DRAWER_UPSELL_CONFIG = {
    eligibilityUrl: "/apps/checkout-upsell/api/offers/eligible",
    viewedUrl: "/apps/checkout-upsell/api/offers/viewed",
    clickedUrl: "/apps/checkout-upsell/api/offers/clicked",
    addedToCartUrl: "/apps/checkout-upsell/api/offers/added-to-cart",
    customerId: {% if customer %}"gid://shopify/Customer/{{ customer.id }}"{% else %}null{% endif %},
    shop: {{ shop.permanent_domain | json }},
    designMode: {{ request.design_mode | json }},
    editorPreviewEnabled: {{ block.settings.show_theme_editor_preview | json }},
    editorPreviewMessage: {{ block.settings.editor_preview_message | json }},
    previewPromoLabel: {{ block.settings.preview_promo_text | json }},
    previewBadgeLabel: {{ "cart_upsell.preview_badge" | t | json }},
    previewProducts: [
      {%- for preview_product in block.settings.preview_products -%}
        {
          "productId": "gid://shopify/Product/{{ preview_product.id }}",
          "variantId": "gid://shopify/ProductVariant/{{ preview_product.selected_or_first_available_variant.id }}",
          "productTitle": {{ preview_product.title | json }},
          "variantTitle": {{ preview_product.selected_or_first_available_variant.title | json }},
          "price": {{ preview_product.selected_or_first_available_variant.price | money_without_currency | json }},
          "imageUrl": {{ preview_product.featured_image | image_url: width: 200 | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    addToCartLabel: {% if block.settings.add_to_cart_text != blank %}{{ block.settings.add_to_cart_text | json }}{% else %}{{ "cart_upsell.add_to_cart" | t | json }}{% endif %},
    viewLabel: {{ "product_upsell.view" | t | json }}
  };
</script>

{% schema %}
{
  "name": "Cart Drawer Upsell",
  "target": "body",
  "javascript": "cart-drawer-upsell.js",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading_text", "label": "Heading text", "default": "You might also like" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#111111" },
    { "type": "range", "id": "heading_font_size", "label": "Heading font size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "show_top_border", "label": "Show divider above upsell", "default": true },
    { "type": "header", "content": "Card styling" },
    { "type": "color", "id": "card_bg_color", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Border / divider color", "default": "#e5e5e5" },
    { "type": "range", "id": "card_corner_radius", "label": "Card corner radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 6 },
    { "type": "color", "id": "title_color", "label": "Product title color", "default": "#111111" },
    { "type": "color", "id": "subtext_color", "label": "Secondary text color", "default": "#666666" },
    { "type": "color", "id": "price_color", "label": "Price color", "default": "#666666" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "add_to_cart_text", "label": "Add to cart button text", "default": "Add to cart" },
    { "type": "color", "id": "button_bg_color", "label": "Add to cart background", "default": "#111111" },
    { "type": "color", "id": "button_text_color", "label": "Add to cart text color", "default": "#ffffff" },
    { "type": "range", "id": "button_corner_radius", "label": "Button corner radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 4 },
    { "type": "header", "content": "Error message" },
    { "type": "color", "id": "error_color", "label": "Error text color", "default": "#d32f2f" },
    { "type": "header", "content": "Theme editor preview" },
    {
      "type": "checkbox",
      "id": "show_theme_editor_preview",
      "label": "Show preview when no offer matches",
      "default": true,
      "info": "In the theme editor only: display a message and sample cards so the block is visible while you configure offers."
    },
    {
      "type": "textarea",
      "id": "editor_preview_message",
      "label": "No-match message (theme editor)",
      "default": "No Cart Drawer offer matches this preview cart. Create an active offer with Cart Drawer display and add a trigger product to the cart."
    },
    {
      "type": "text",
      "id": "preview_promo_text",
      "label": "Sample promo line on preview cards",
      "default": "Example promotional title"
    },
    {
      "type": "product_list",
      "id": "preview_products",
      "label": "Preview products (optional)",
      "limit": 4,
      "info": "Used in the theme editor when no offer matches. Leave empty to use generic placeholders."
    }
  ]
}
{% endschema %}